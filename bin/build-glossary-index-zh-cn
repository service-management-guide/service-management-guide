"Software bill of materials (SBOM)": ("软件物料清单（SBOM）", "软件中各组成部分的清单，附有版本和许可证。"),
"Telemetry": ("遥测", "系统自身发出的数据，主要是指标、日志和追踪。"),
"Toil": ("繁琐工作（toil）", "手工的、重复的、可自动化的工作，随服务增长而增加，且不带来持久的价值。"),
"Value stream": ("价值流", "组织为创建并向消费者交付产品或服务而采取的一系列步骤。"),
"Work in progress (WIP)": ("在制品（WIP）", "已开始但尚未完成的事项数量。"),
}
src = open(f"{root}/glossary/index.md").read()
ents = re.findall(r"^\*\*(.+?)\*\* — (.+?) — See Topic (\d+\.\d+) — (.+?)\.$", src, re.M)
missing = [e[0] for e in ents if e[0] not in ZH]
if missing or len(ents) != len(ZH): sys.exit(f"mismatch {missing} {len(ents)} {len(ZH)}")
o = ["# 术语表", "",
     "关键术语的 A–Z 定义（按英文术语排序），每一条都指向它的主要主题。格式：**英文术语（中文）** — 定义。— 见主题 N.N — 标题。专有名称和英文缩写保持原文写法。用词选择见 `locales/zh-cn/术语/index.md`。本译文是草稿，等待精通中文者的审校。", ""]
cur = None
for en, _, n, _ in ents:
    L = en[0].upper()
    if L != cur: o += [f"## {L}", ""]; cur = L
    zt, zd = ZH[en]
    head = f"**{en}**" if zt == en else f"**{en}（{zt}）**"
    o += [f"{head} — {zd} — 见主题 {n} — {title[n]}。", ""]
os.makedirs(f"{root}/locales/zh-cn/术语表", exist_ok=True); open(f"{root}/locales/zh-cn/术语表/index.md", "w").write("\n".join(o))
isrc = open(f"{root}/index/index.md").read()
ients = re.findall(r"^\*\*(.+?)\*\* — (.+)$", isrc, re.M)
o = ["# 索引", "",
     "按主题编号列出的概念和框架。格式：**英文术语（中文）** — N.N、N.N、……编号升序、去重：包括主要主题，以及深入涉及该概念的每个主题。标题见 README 的目录。本译文是草稿，等待精通中文者的审校。", ""]
cur = None; bad = []
for en, ns in ients:
    if en not in ZH: bad.append(en); continue
    L = en[0].upper()
    if L != cur: o += [f"## {L}", ""]; cur = L
    zt = ZH[en][0]
    head = f"**{en}**" if zt == en else f"**{en}（{zt}）**"
    o += [f"{head} — {ns.replace(', ', '、')}", ""]
os.makedirs(f"{root}/locales/zh-cn/索引", exist_ok=True); open(f"{root}/locales/zh-cn/索引/index.md", "w").write("\n".join(o))
print("glossary", len(ents), "index", len(ients), "unmapped", bad)
