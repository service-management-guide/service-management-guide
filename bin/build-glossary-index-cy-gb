}
src = open(f"{root}/glossary/index.md").read()
ents = re.findall(r"^\*\*(.+?)\*\* — (.+?) — See Topic (\d+\.\d+) — (.+?)\.$", src, re.M)
missing = [e[0] for e in ents if e[0] not in CY]
if missing or len(ents) != len(CY): sys.exit(f"mismatch {missing} {len(ents)} {len(CY)}")
o = ["# Geirfa", "",
     "Diffiniadau A–Z o dermau allweddol (wedi'u trefnu yn ôl y term Saesneg), pob un yn cyfeirio at ei brif bwnc. Fformat: **Term Saesneg (Cymraeg)** — diffiniad. — Gweler Pwnc N.N — Teitl. Mae enwau priod a byrfoddau Saesneg yn aros fel y'u hysgrifennwyd. Gweler `locales/cy-gb/terminoleg/index.md` am y dewisiadau geiriau. Drafft yw'r cyfieithiad hwn, sy'n aros am adolygiad gan siaradwr Cymraeg rhugl.", ""]
cur = None
for en, _, n, _ in ents:
    L = en[0].upper()
    if L != cur: o += [f"## {L}", ""]; cur = L
    ct, cd = CY[en]
    head = f"**{en}**" if ct == en else f"**{en} ({ct})**"
    o += [f"{head} — {cd} — Gweler Pwnc {n} — {title[n]}.", ""]
os.makedirs(f"{root}/locales/cy-gb/geirfa", exist_ok=True); open(f"{root}/locales/cy-gb/geirfa/index.md", "w").write("\n".join(o))
isrc = open(f"{root}/index/index.md").read()
ients = re.findall(r"^\*\*(.+?)\*\* — (.+)$", isrc, re.M)
o = ["# Mynegai", "",
     "Cysyniadau a fframweithiau yn ôl rhif y pwnc. Fformat: **Term Saesneg (Cymraeg)** — N.N, N.N, … Mae'r rhifau mewn trefn esgynnol a heb ddyblygu: y prif bwnc, ynghyd â phob pwnc sy'n trafod y cysyniad yn sylweddol. Mae'r teitlau yn y tabl cynnwys yn y README. Drafft yw'r cyfieithiad hwn, sy'n aros am adolygiad gan siaradwr Cymraeg rhugl.", ""]
cur = None; bad = []
for en, ns in ients:
    if en not in CY: bad.append(en); continue
    L = en[0].upper()
    if L != cur: o += [f"## {L}", ""]; cur = L
    ct = CY[en][0]
    head = f"**{en}**" if ct == en else f"**{en} ({ct})**"
    o += [f"{head} — {ns}", ""]
os.makedirs(f"{root}/locales/cy-gb/mynegai", exist_ok=True); open(f"{root}/locales/cy-gb/mynegai/index.md", "w").write("\n".join(o))
print("glossary", len(ents), "index", len(ients), "unmapped", bad)
